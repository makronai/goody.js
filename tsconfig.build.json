{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src/goodyjs",
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true
  },
  "include": ["src/goodyjs/**/*"]
}
